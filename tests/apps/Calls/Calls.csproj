<Project Sdk="Microsoft.NET.Sdk">
  <!-- ラムダを渡す呼び出しのオーバーロード試験の対象。Generated.cs は tools/exprgen が target/calls に作る (tests/apps/build.ps1 が先に実行する)。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <DebugType>portable</DebugType>
    <AssemblyName>Calls</AssemblyName>
    <Nullable>disable</Nullable>
    <WarningLevel>0</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\target\calls\Generated.cs" Link="Generated.cs" />
  </ItemGroup>
</Project>
