<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 版のスモーク試験の対象。ソースは Console と同じものを使う（目印の行も共通）。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <DebugType>portable</DebugType>
    <AssemblyName>SmokeConsole48</AssemblyName>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- 式の適合試験が新しい C# の書き方を使う。.NET Framework 向けでも、言語の版だけは上げられる。 -->
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 適合試験のポインターの式 (Conformance.Run の終わりの unsafe ブロック)。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Console\Program.cs" />
    <!-- 適合試験の dynamic に要る (.NET Framework では、既定で参照しない)。 -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>